{
  "name": "trevorhibblen.com",
  "type": "module",
  "version": "0.0.2",
  "scripts": {
    "ci": "pnpm install --frozen-lockfile",
    "dev": "astro dev",
    "test": "bun test",
    "cy:test": "bun run preview & bun run e2e",
    "pub": "bun run upload",
    "db:latest": "bun spike/database.ts",
    "e2e": "cypress run",
    "cy:open": "cypress open",
    "postcy:test": "bun run kill-http-server",
    "kill-http-server": "bun src/lib/kill-http-server.ts",
    "preview": "http-server dist -p 4321",
    "prepreview": "bun run build",
    "astro": "astro",
    "astro:disable:tb": "astro preferences disable devToolbar",
    "build": "astro build",
    "prepub": "bun run build",
    "postpub": "bun run clearcache; echo 'Done'",
    "clearcache": "bun deploy/clear-cache.ts",
    "upload": "bun deploy/upload.ts"
  },
  "dependencies": {
    "@astrojs/solid-js": "5.1.3",
    "@kobalte/core": "0.13.14",
    "@tailwindcss/vite": "4.1.17",
    "astro": "5.16.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-solid": "1.47.0",
    "solid-js": "1.9.15",
    "tailwind-merge": "2.5.5",
    "tailwindcss": "4.1.17",
    "tailwindcss-animate": "1.0.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudfront": "3.716.0",
    "@tailwindcss/typography": "0.5.15",
    "@types/bun": "1.3.2",
    "cypress": "14.0.1",
    "dotenv": "16.4.7",
    "http-server": "14.1.1",
    "jest": "29.7.0",
    "mime": "4.0.6",
    "tailwindcss-animated": "1.1.2",
    "tw-animate-css": "1.3.4"
  }
}
